# Database and Supabase
# Local development can use the owner URL below. Deployed application runtimes
# must use the service-specific non-owner URL from the release runbook.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54622/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# AWS and Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Agent runtime and scheduling
AGENT_RUNTIME=local
MODEL=scripted
AGENTCORE_RUNTIME_ARN=replace-with-agentcore-runtime-arn
SCHEDULER=none
SCHEDULER_ROLE_ARN=replace-with-scheduler-role-arn
SCHEDULER_DLQ_ARN=replace-with-scheduler-dlq-arn

# Application and demo
DEMO_MODE=false
DEMO_SESSION_SECRET=replace-with-at-least-32-random-bytes
LINK_TOKEN_SECRET=replace-with-at-least-32-random-bytes
CALENDAR_FEED_SECRET=replace-with-a-different-at-least-32-random-byte-secret
TICK_SECRET=replace-with-at-least-32-random-bytes
AGENT_ROUTE_SECRET=replace-with-a-different-at-least-32-random-byte-secret
CRON_SECRET=replace-with-at-least-32-random-bytes
APP_URL=http://localhost:3008
