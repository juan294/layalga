<mxfile host="claude-code">
  <diagram name="L Ayalga architecture">
    <mxGraphModel adaptiveColors="auto" background="#FFFFFF" grid="0" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="L’Ayalga — AI hospitality coordinator for shared homes" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1400" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Next.js 16 on Vercel · Strands Agents SDK on Amazon Bedrock AgentCore Runtime (selected; AGENT_RUNTIME=local is the one-flag rollback) · Supabase PostgreSQL as the authority · Amazon Bedrock Claude Sonnet 4.5 · AgentCore Memory · Amazon SES host pings · ADOT tracing to CloudWatch" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4A5058;" vertex="1" parent="1"><mxGeometry x="42" y="52" width="1700" height="24" as="geometry"/></mxCell>

        <mxCell id="ZA" value="People, clients and platform triggers" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;fillColor=#F8F4EA;strokeColor=#9A7B45;fontColor=#4A3A1E;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="1180" as="geometry"/></mxCell>
        <mxCell id="ZB" value="Vercel — Next.js 16 App Router  (database role: layalga_web)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;fillColor=#EDF3FB;strokeColor=#2C5F9E;fontColor=#10365C;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="620" height="1180" as="geometry"/></mxCell>
        <mxCell id="ZC" value="Agent runtime — Strands Agents SDK on AgentCore Runtime" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;fillColor=#EAF6EF;strokeColor=#2C7A56;fontColor=#154430;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="560" height="1180" as="geometry"/></mxCell>
        <mxCell id="ZE" value="AWS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;fillColor=#F2F3F5;strokeColor=#69707A;fontColor=#2B3038;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="1700" y="90" width="520" height="760" as="geometry"/></mxCell>
        <mxCell id="ZL" value="Legend" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;fillColor=#FFFFFF;strokeColor=#69707A;fontColor=#2B3038;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="1700" y="880" width="520" height="390" as="geometry"/></mxCell>
        <mxCell id="ZD" value="Supabase PostgreSQL — system of record  (authoritative for availability, holds, visits and household policy; the model never mutates booking state directly)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;fillColor=#FDF4E4;strokeColor=#B07C1E;fontColor=#5E3F04;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="2180" height="370" as="geometry"/></mxCell>

        <mxCell id="ZB1" value="App Router pages — next-intl locales en / es" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#8FB4DC;fontColor=#20456E;dashed=0;" vertex="1" parent="1"><mxGeometry x="418" y="130" width="584" height="402" as="geometry"/></mxCell>
        <mxCell id="ZB2" value="Route handlers and Server Actions" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#8FB4DC;fontColor=#20456E;" vertex="1" parent="1"><mxGeometry x="418" y="560" width="584" height="340" as="geometry"/></mxCell>
        <mxCell id="ZB3" value="Deterministic domain core — src/core  (no model in the loop)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#8FB4DC;fontColor=#20456E;" vertex="1" parent="1"><mxGeometry x="418" y="930" width="584" height="320" as="geometry"/></mxCell>
        <mxCell id="ZC6" value="10 typed tools — src/agent/tools" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#8AC0A2;fontColor=#1B5C3E;" vertex="1" parent="1"><mxGeometry x="1098" y="776" width="524" height="312" as="geometry"/></mxCell>

        <mxCell id="A6" value="&lt;b&gt;Browser MCP client&lt;/b&gt;&lt;br&gt;document.modelContext&lt;br&gt;WebMCP, optional" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#9A7B45;fontColor=#3A2E15;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="A1" value="&lt;b&gt;Hosts — Juan and Jordan&lt;/b&gt;&lt;br&gt;Google OAuth, host identity claim" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#9A7B45;fontColor=#3A2E15;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="256" width="260" height="64" as="geometry"/></mxCell>
        <mxCell id="A2" value="&lt;b&gt;Invited family&lt;/b&gt;&lt;br&gt;private invitation link, expiring token" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#9A7B45;fontColor=#3A2E15;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="326" width="260" height="64" as="geometry"/></mxCell>
        <mxCell id="A3" value="&lt;b&gt;Guest account&lt;/b&gt;&lt;br&gt;optional claim, own visit ledger" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#9A7B45;fontColor=#3A2E15;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="394" width="260" height="64" as="geometry"/></mxCell>
        <mxCell id="A4" value="&lt;b&gt;Demo visitor&lt;/b&gt;&lt;br&gt;signed synthetic session, no real data" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#9A7B45;fontColor=#3A2E15;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="462" width="260" height="64" as="geometry"/></mxCell>
        <mxCell id="TG1" value="&lt;b&gt;Vercel Cron&lt;/b&gt;&lt;br&gt;schedule * * * * *&lt;br&gt;CRON_SECRET bearer" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F1F3F6;strokeColor=#69707A;fontColor=#2B3038;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="TG2" value="&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;Google OAuth, guest party claim,&lt;br&gt;signed demo session" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F1F3F6;strokeColor=#69707A;fontColor=#2B3038;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="A5" value="&lt;b&gt;Host calendar app&lt;/b&gt;&lt;br&gt;iCal subscription over a&lt;br&gt;per-feed bearer token" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#9A7B45;fontColor=#3A2E15;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="TG3" value="&lt;b&gt;Injectable demo clock&lt;/b&gt;&lt;br&gt;explicitly labelled synthetic time&lt;br&gt;for the demo driver" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F1F3F6;strokeColor=#69707A;fontColor=#2B3038;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="910" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="NOTE" value="&lt;b&gt;Safety contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;PostgreSQL is authoritative. The model proposes;&lt;br&gt;deterministic code decides and writes.&lt;br&gt;&lt;br&gt;A queued acknowledgement is accepted work,&lt;br&gt;never a completed result — the exact run is&lt;br&gt;polled to a terminal state." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=10;fillColor=#FFF8E8;strokeColor=#B07C1E;fontColor=#4A3204;" vertex="1" parent="1"><mxGeometry x="60" y="1020" width="260" height="150" as="geometry"/></mxCell>

        <mxCell id="P7" value="&lt;b&gt;WebMCP tool registration&lt;/b&gt; — src/components/webmcp · registered only when document.modelContext exists&lt;br&gt;layalga.guest.read_room_options · prepare_search · prepare_booking  |  layalga.host.read_rooms · prepare_private_block · prepare_room_control&lt;br&gt;Reuses the active page authority. Read and prepare only — never submits a write, never accepts a home id, host id, token or record." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F4F8FD;strokeColor=#2C5F9E;fontColor=#10365C;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="432" y="176" width="558" height="64" as="geometry"/></mxCell>
        <mxCell id="P1" value="&lt;b&gt;Host console&lt;/b&gt;&lt;br&gt;/[locale]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="432" y="258" width="272" height="54" as="geometry"/></mxCell>
        <mxCell id="P2" value="&lt;b&gt;Sign in&lt;/b&gt;&lt;br&gt;/[locale]/sign-in" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="718" y="258" width="272" height="54" as="geometry"/></mxCell>
        <mxCell id="P3" value="&lt;b&gt;Guest invitation page&lt;/b&gt;&lt;br&gt;/[locale]/g/[token]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="432" y="326" width="272" height="54" as="geometry"/></mxCell>
        <mxCell id="P6" value="&lt;b&gt;Run status&lt;/b&gt;&lt;br&gt;/[locale]/runs/[id]/status" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="718" y="326" width="272" height="54" as="geometry"/></mxCell>
        <mxCell id="P5" value="&lt;b&gt;Guest visit ledger&lt;/b&gt;&lt;br&gt;/[locale]/visits" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="432" y="394" width="272" height="54" as="geometry"/></mxCell>
        <mxCell id="P9" value="&lt;b&gt;React components&lt;/b&gt;&lt;br&gt;&lt;br&gt;host: room ledger · calendar ledger and&lt;br&gt;feed controls · pending decisions ·&lt;br&gt;capture invitation form · demo clock panel ·&lt;br&gt;What L’Ayalga remembers (list · Forget) ·&lt;br&gt;email ping opt-out&lt;br&gt;&lt;br&gt;guest: invite form · actions&lt;br&gt;runs: run status poller" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;fillColor=#F4F8FD;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="718" y="394" width="272" height="136" as="geometry"/></mxCell>
        <mxCell id="P4" value="&lt;b&gt;Demo entry&lt;/b&gt;&lt;br&gt;/[locale]/demo-enter" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="432" y="462" width="272" height="54" as="geometry"/></mxCell>

        <mxCell id="R1" value="&lt;b&gt;Server Actions&lt;/b&gt;&lt;br&gt;host operations and guest answers" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="432" y="606" width="272" height="54" as="geometry"/></mxCell>
        <mxCell id="R2" value="&lt;b&gt;POST /api/agent/run&lt;/b&gt;&lt;br&gt;enqueue, then Vercel after() dispatch to AgentCore" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="718" y="606" width="272" height="54" as="geometry"/></mxCell>
        <mxCell id="R4" value="&lt;b&gt;GET /api/ticks&lt;/b&gt; — Vercel Cron entry, maxDuration 300 s, internal secret or CRON_SECRET&lt;br&gt;recover stale leases · drain queued runs · claim due jobs · dispatch email pings" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F4F8FD;strokeColor=#2C5F9E;fontColor=#10365C;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="432" y="680" width="558" height="58" as="geometry"/></mxCell>
        <mxCell id="R5" value="&lt;b&gt;/auth/callback · prepare · sign-out&lt;/b&gt;&lt;br&gt;host claim, guest party claim, safe next path" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="432" y="762" width="272" height="54" as="geometry"/></mxCell>
        <mxCell id="R3" value="&lt;b&gt;GET /api/runs/[id]&lt;/b&gt;&lt;br&gt;poll the exact run to a terminal state" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="718" y="762" width="272" height="54" as="geometry"/></mxCell>
        <mxCell id="R7" value="&lt;b&gt;GET /calendar/[token]&lt;/b&gt;&lt;br&gt;iCalendar feed, read only, no-store, ETag" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="432" y="830" width="272" height="54" as="geometry"/></mxCell>
        <mxCell id="R6" value="&lt;b&gt;/api/demo/clock · /api/demo/reset&lt;/b&gt;&lt;br&gt;&lt;b&gt;/api/health&lt;/b&gt; — leased and rate limited" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="718" y="830" width="272" height="54" as="geometry"/></mxCell>

        <mxCell id="C1" value="&lt;b&gt;policy/&lt;/b&gt; evaluate-overlap · allocate-rooms&lt;br&gt;beds → children → pets → room selection" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="432" y="974" width="272" height="56" as="geometry"/></mxCell>
        <mxCell id="C2" value="&lt;b&gt;rooms/&lt;/b&gt; availability · occupancy · search&lt;br&gt;recommendation · proposals · limits" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="718" y="974" width="272" height="56" as="geometry"/></mxCell>
        <mxCell id="C3" value="&lt;b&gt;booking/&lt;/b&gt; invitations · holds · house-state&lt;br&gt;option-window · stay approval hash" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="432" y="1042" width="272" height="56" as="geometry"/></mxCell>
        <mxCell id="C4" value="&lt;b&gt;calendar/&lt;/b&gt; feed-token HMAC · ical renderer&lt;br&gt;calendar-feed projection, generic text only" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="718" y="1042" width="272" height="56" as="geometry"/></mxCell>
        <mxCell id="C6" value="&lt;b&gt;db/client.ts&lt;/b&gt; single pool, non-owner role&lt;br&gt;&lt;b&gt;clock&lt;/b&gt; injectable · &lt;b&gt;data-retention&lt;/b&gt; sweep" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F4F8FD;strokeColor=#2C5F9E;fontColor=#10365C;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="432" y="1110" width="272" height="56" as="geometry"/></mxCell>
        <mxCell id="C5" value="&lt;b&gt;reconfirmation/&lt;/b&gt; state-machine · jobs&lt;br&gt;apply-guest-answer" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#2C5F9E;fontColor=#10365C;" vertex="1" parent="1"><mxGeometry x="718" y="1110" width="272" height="56" as="geometry"/></mxCell>

        <mxCell id="R8" value="&lt;b&gt;notifications/email-outbox.ts&lt;/b&gt; — host_email_pings outbox&lt;br&gt;dispatchHostEmailPings from cron /api/ticks, the demo clock&lt;br&gt;and the host page after() · hosts only · idempotent per host" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F4F8FD;strokeColor=#2C5F9E;fontColor=#10365C;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="718" y="1178" width="272" height="60" as="geometry"/></mxCell>

        <mxCell id="D1" value="&lt;b&gt;agent/client.ts&lt;/b&gt;&lt;br&gt;AgentCoreClient (selected) or LocalAgentClient (rollback) — enqueue, acknowledge, execute the queued run" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#2C7A56;fontColor=#123D2A;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1100" y="140" width="520" height="64" as="geometry"/></mxCell>
        <mxCell id="D2" value="&lt;b&gt;agent/queue.ts — drainAgentQueue&lt;/b&gt;&lt;br&gt;claim an exact run by lease · concurrency 2 · at most 3 execution attempts&lt;br&gt;reclaim leases stale for 6 minutes · invalid payloads fail closed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#2C7A56;fontColor=#123D2A;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1100" y="234" width="520" height="86" as="geometry"/></mxCell>
        <mxCell id="D3" value="&lt;b&gt;run-task.ts — runAgentTask&lt;/b&gt;  durable worker, idempotency keyed&lt;br&gt;executes inside the AgentCore handler (runtime/agentcore.ts), or in-process on rollback" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#2C7A56;fontColor=#123D2A;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1100" y="350" width="520" height="58" as="geometry"/></mxCell>
        <mxCell id="D4" value="&lt;b&gt;Strands Agent&lt;/b&gt;&lt;br&gt;system prompt · prompt minimization · tenant scoping · task limits&lt;br&gt;MemoryManager: search_memory tool, one namespace per party, no family names" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#2C7A56;fontColor=#123D2A;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1100" y="438" width="520" height="72" as="geometry"/></mxCell>
        <mxCell id="DM" value="&lt;b&gt;Configured model&lt;/b&gt;&lt;br&gt;Amazon Bedrock Claude Sonnet 4.5 in production (MODEL=bedrock),&lt;br&gt;or the scripted deterministic model for demo and tests" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2FAF5;strokeColor=#2C7A56;fontColor=#123D2A;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1100" y="540" width="520" height="76" as="geometry"/></mxCell>
        <mxCell id="D5" value="&lt;b&gt;Policy hook — BeforeToolCallEvent&lt;/b&gt;&lt;br&gt;gates create_temporary_hold · confirm_visit · reschedule_visit&lt;br&gt;verdict: allow · interrupt for host approval · deny&lt;br&gt;every verdict is written to audit_events" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FDEDEA;strokeColor=#B23A2B;fontColor=#6E1F14;strokeWidth=2;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1100" y="646" width="520" height="100" as="geometry"/></mxCell>

        <mxCell id="T1" value="capture_invitation" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2FAF5;strokeColor=#2C7A56;fontColor=#123D2A;" vertex="1" parent="1"><mxGeometry x="1112" y="822" width="244" height="42" as="geometry"/></mxCell>
        <mxCell id="T2" value="find_visit_options" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2FAF5;strokeColor=#2C7A56;fontColor=#123D2A;" vertex="1" parent="1"><mxGeometry x="1370" y="822" width="244" height="42" as="geometry"/></mxCell>
        <mxCell id="T3" value="evaluate_overlap" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2FAF5;strokeColor=#2C7A56;fontColor=#123D2A;" vertex="1" parent="1"><mxGeometry x="1112" y="874" width="244" height="42" as="geometry"/></mxCell>
        <mxCell id="T4" value="create_temporary_hold" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FDEDEA;strokeColor=#B23A2B;fontColor=#6E1F14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1370" y="874" width="244" height="42" as="geometry"/></mxCell>
