flowchart LR
  host["Nel + Covadonga<br/>host view"]
  guest["Invited family<br/>private link"]
  guestAccount["Optional guest account<br/>claim • /visits • sign out"]

  subgraph vercel["Vercel • selected runtime"]
    web["Next.js 16<br/>English + Spanish<br/>layalga_web role"]
    cron["Cron /api/ticks<br/>recover • drain 2 • due jobs"]
    dispatch["after() dispatch"]
    worker["runAgentTask worker<br/>Strands • 7 typed tools"]
    policy["Policy hook<br/>beds → children → pets<br/>→ human exception"]
  end

  subgraph data["Supabase Postgres • authority"]
    identity["Identity claims<br/>hosts + guests"]
    queue["Runs queue<br/>leases • attempts • idempotency"]
    state["Invitations • visits • rooms<br/>sessions • decisions • audit"]
    jobs["Jobs • notifications<br/>retry 1m / 5m • quarantine after 3"]
  end

  models["Configured model<br/>scripted demo or Bedrock Sonnet 4.5"]
  agentcore["AgentCore execute_run<br/>existing run ID • async task<br/>future layalga_agent role"]
  eventbridge["EventBridge Scheduler<br/>future trigger"]

  host --> web
  guest --> web
  guest --> guestAccount --> web
  web --> identity
  web -- "enqueue + acknowledge" --> queue
  web --> dispatch --> worker
  cron --> queue
  cron --> jobs
  jobs -- "enqueue tick" --> queue
  queue -- "claim exact run" --> worker
  worker --> policy
  policy -- "authorized state change<br/>or interrupt snapshot" --> state
  worker --> jobs
  worker -.-> models
  queue -. "execute_run" .-> agentcore
  eventbridge -.-> agentcore
  agentcore -.-> models

  classDef person fill:#f6f0e4,stroke:#143f3b,color:#15201f,stroke-width:2px;
  classDef app fill:#143f3b,stroke:#143f3b,color:#fffdf7,stroke-width:2px;
  classDef core fill:#d7e5df,stroke:#143f3b,color:#15201f,stroke-width:2px;
  classDef store fill:#fffdf7,stroke:#a46d3c,color:#15201f,stroke-width:2px;
  classDef future fill:#eee8dc,stroke:#756b61,color:#3a3530,stroke-width:2px,stroke-dasharray: 7 5;
  class host,guest,guestAccount person;
  class web,dispatch,worker,cron app;
  class policy,models core;
  class identity,queue,state,jobs store;
  class agentcore,eventbridge future;
