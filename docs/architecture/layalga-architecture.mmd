flowchart LR
  host["Juan + Jordan<br/>host view"]
  guest["Invited family<br/>stay-aligned revocable link"]
  guestAccount["Optional guest account<br/>claim • /visits • sign out"]
  calendarApp["Host's calendar app<br/>iCal subscription"]

  subgraph vercel["Vercel"]
    web["Next.js 16<br/>English + Spanish<br/>layalga_web role"]
    cron["Cron /api/ticks<br/>recover • drain • due jobs"]
    dispatch["after() dispatch"]
    webmcp["WebMCP guest/host tools<br/>page-registered • prepare-only"]
    calendarFeed["Calendar feed route<br/>/calendar/[token] • HMAC token"]
    emailOutbox["Host outbox<br/>decision and escalation pings"]
    guestContact["Guest consent and verification<br/>POST verify • signed return capability"]
    guestOutbox["Guest outbox • web only<br/>source checks • authorization receipts<br/>accepted / failed / unknown"]
    hostControls["Host decisions and outcomes<br/>policy version • cancellation • notes"]
    demo["Shared synthetic guide<br/>routine then exception<br/>next eligible job clock • no guest email"]
    preferenceRead["Scoped memory read<br/>bounded preference mapping<br/>feasible rooms • explained ranking"]
  end

  subgraph agentcore["AgentCore Runtime • selected • layalga_agent role"]
    worker["Strands Agent<br/>task-scoped typed tools"]
    policy["Policy hook<br/>beds → children → pets<br/>→ room selection → human exception"]
    rooms["Room services<br/>availability • occupancy<br/>proposals • recommendation"]
    otel["ADOT for Node<br/>→ CloudWatch GenAI Observability"]
  end

  subgraph data["Supabase Postgres • authority"]
    identity["Identity claims<br/>hosts + guests"]
    queue["Runs queue<br/>leases • attempts • idempotency"]
    state["Invitations • visits • rooms<br/>sessions • decisions • audit<br/>private visit notes • policy version"]
    jobs["Jobs • notifications<br/>host_email_pings<br/>retry 1m / 5m • quarantine after 3"]
    contacts["Guest contacts • consent generation<br/>guest_email_outbox • guest_email_attempts<br/>web only • no agent access"]
  end

  models["Amazon Bedrock<br/>Sonnet 4.6<br/>scripted for tests + demo driver"]
  memory["AgentCore Memory<br/>household preferences • facts"]
  ses["Amazon SES<br/>host pings; guest verification and reminders<br/>guest IAM / production rollout pending"]
  eventbridge["EventBridge Scheduler<br/>future retry trigger"]

