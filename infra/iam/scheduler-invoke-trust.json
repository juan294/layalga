{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EventBridgeSchedulerAssumeRole",
      "Effect": "Allow",
      "Principal": {
        "Service": "scheduler.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "106403001709",
          "aws:SourceArn": "arn:aws:scheduler:us-east-1:106403001709:schedule-group/default"
        }
      }
    }
  ]
}
